From 77bd5df9b6fc89087bc61cce18e4468dd4db7ecf Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Rapha=C3=ABl=20Erard?= <rerardd@gmail.com>
Date: Fri, 3 Apr 2026 21:33:06 +0200
Subject: [PATCH 1/3] Turn off screen after delay

---
 src/frontend/greeter/greetereventfilter.cpp | 29 ++++++++++++---------
 src/frontend/greeter/greetereventfilter.h   |  2 ++
 src/frontend/greeter/qml/GreeterState.qml   | 13 +++++++++
 src/frontend/greeter/qml/Main.qml           |  9 +++++++
 4 files changed, 40 insertions(+), 13 deletions(-)

diff --git a/src/frontend/greeter/greetereventfilter.cpp b/src/frontend/greeter/greetereventfilter.cpp
index f354e37d..1fe734d6 100644
--- a/src/frontend/greeter/greetereventfilter.cpp
+++ b/src/frontend/greeter/greetereventfilter.cpp
@@ -40,6 +40,21 @@ void GreeterEventFilter::setWindow(QQuickWindow *window)
     Q_EMIT windowChanged();
 }
 
+void GreeterEventFilter::turnOffScreens()
+{
+    auto dpms = new KScreen::Dpms(this);
+    if (dpms->isSupported()) {
+        connect(dpms, &KScreen::Dpms::hasPendingChangesChanged, this, [dpms](bool hasPendingChanges) {
+            if (!hasPendingChanges) {
+                dpms->deleteLater();
+            }
+        });
+        dpms->switchMode(KScreen::Dpms::Off);
+    } else {
+        dpms->deleteLater();
+    }
+}
+
 bool GreeterEventFilter::eventFilter(QObject *obj, QEvent *event)
 {
     Q_UNUSED(obj)
@@ -48,19 +63,7 @@ bool GreeterEventFilter::eventFilter(QObject *obj, QEvent *event)
         auto *keyEvent = static_cast<QKeyEvent *>(event);
 
         if (keyEvent->key() == Qt::Key_Escape) {
-            // Esc -> turn off screens
-            auto dpms = new KScreen::Dpms(this);
-            if (dpms->isSupported()) {
-                connect(dpms, &KScreen::Dpms::hasPendingChangesChanged, this, [dpms](bool hasPendingChanges) {
-                    if (!hasPendingChanges) {
-                        dpms->deleteLater();
-                    }
-                });
-                dpms->switchMode(KScreen::Dpms::Off);
-            } else {
-                dpms->deleteLater();
-            }
-
+            turnOffScreens();
             Q_EMIT escapeKeyPressed();
 
             return true;
diff --git a/src/frontend/greeter/greetereventfilter.h b/src/frontend/greeter/greetereventfilter.h
index dd31f76a..ff1d68e6 100644
--- a/src/frontend/greeter/greetereventfilter.h
+++ b/src/frontend/greeter/greetereventfilter.h
@@ -18,6 +18,8 @@ public:
     QQuickWindow *window() const;
     void setWindow(QQuickWindow *window);
 
+    Q_INVOKABLE void turnOffScreens();
+
 Q_SIGNALS:
     void windowChanged();
 
diff --git a/src/frontend/greeter/qml/GreeterState.qml b/src/frontend/greeter/qml/GreeterState.qml
index f3233e14..625250d6 100644
--- a/src/frontend/greeter/qml/GreeterState.qml
+++ b/src/frontend/greeter/qml/GreeterState.qml
@@ -117,6 +117,8 @@ Item {
         }
     }
 
+    signal screenOffRequested()
+
     Timer {
         id: greeterTimeoutTimer
         running: false
@@ -125,10 +127,18 @@ Item {
             if (internal.activeWindow) {
                 greeterState.showPassword = false;
                 timeoutWindow(internal.activeWindow);
+                screenOffTimer.start();
             }
         }
     }
 
+    Timer {
+        id: screenOffTimer
+        running: false
+        interval: 30000
+        onTriggered: greeterState.screenOffRequested()
+    }
+
     function clearPasswords(): void {
         userListPassword = "";
         userPromptPassword = "";
@@ -143,6 +153,8 @@ Item {
 
         window.requestActivate();
 
+        screenOffTimer.stop();
+
         if (!inhibitGreeterTimeout) {
             greeterTimeoutTimer.restart();
         }
@@ -154,6 +166,7 @@ Item {
         }
 
         greeterTimeoutTimer.stop();
+        screenOffTimer.stop();
     }
 
     // Remember last logged in user/session
diff --git a/src/frontend/greeter/qml/Main.qml b/src/frontend/greeter/qml/Main.qml
index ae440c0d..c1fe902a 100644
--- a/src/frontend/greeter/qml/Main.qml
+++ b/src/frontend/greeter/qml/Main.qml
@@ -45,6 +45,7 @@ Item {
     }
 
     PlasmaLogin.GreeterEventFilter {
+        id: greeterEventFilter
         window: root.Window.window
 
         onKeyPressed: {
@@ -62,6 +63,14 @@ Item {
         }
     }
 
+    Connections {
+        target: PlasmaLogin.GreeterState
+
+        function onScreenOffRequested(): void {
+            greeterEventFilter.turnOffScreens();
+        }
+    }
+
     MouseArea {
         id: loginScreenRoot
         anchors.fill: parent
-- 
